FROM debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS builder

ARG TARGETARCH

# @MARKER@, check latest versions at:
# https://www.oracle.com/database/technologies/instant-client/linux-x86-64-downloads.html
# https://www.oracle.com/database/technologies/instant-client/linux-arm-aarch64-downloads.html
WORKDIR /opt/oracle
RUN if [ "${TARGETARCH}" = "amd64" ]; then \
        BASIC_URL="https://download.oracle.com/otn_software/linux/instantclient/2326400/instantclient-basiclite-linux.x64-23.26.4.0.0.zip"; \
        ODBC_URL="https://download.oracle.com/otn_software/linux/instantclient/2326400/instantclient-odbc-linux.x64-23.26.4.0.0.zip"; \
    elif [ "${TARGETARCH}" = "arm64" ]; then \
        BASIC_URL="https://download.oracle.com/otn_software/linux/instantclient/2326400/instantclient-basiclite-linux.arm64-23.26.4.0.0.zip"; \
        ODBC_URL="https://download.oracle.com/otn_software/linux/instantclient/2326400/instantclient-odbc-linux.arm64-23.26.4.0.0.zip"; \
    fi && \
    wget -qO basiclite.zip "${BASIC_URL}" && wget -qO odbc.zip "${ODBC_URL}"

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:29ee70762214fe8190cea04ef1c0a84a8365879e047ce8f911ae5a5ab2355fa2
