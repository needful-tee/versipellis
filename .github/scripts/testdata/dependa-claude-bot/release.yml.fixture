name: Release

on:
  push:
    tags: ["v*"]

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Check out unixODBC
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: lurcher/unixODBC
          ref: v2.3.14 # https://github.com/lurcher/unixODBC/releases (@MARKER@)
          path: unixODBC
